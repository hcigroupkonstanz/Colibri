{
  "name": "colibri-server",
  "version": "1.3.1",
  "main": "dist/server/main.js",
  "author": "HCI Group, University of Konstanz",
  "scripts": {
    "lint": "eslint \"**/*.{js,ts}\"",
    "build": "npm run gui:build && npm run server:build",
    "start": "npm run server:start",
    "watch": "concurrently -k -p \"[{name}]\" -n \"Angular,Server-Compile,Server-Node\" -c \"green.bold,blue.bold,yellow.bold\" \"npm run gui:watch\" \"npm run server:watch:ts\" \"npm run server:watch:node\"",
    "publish": "node publish.js",
    "gui:build": "ng build --configuration production",
    "gui:watch": "ng serve",
    "server:start": "node dist/server/main.js",
    "server:build": "tsc --p src/server",
    "server:watch:ts": "tsc --p src/server -w",
    "server:watch:node": "nodemon --watch dist/server/* --exec \"npm run server:start\"",
    "test:tcpclient": "tsx test/tcp-client-test.ts"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "21.2.11",
    "@angular/cdk": "^21.2.9",
    "@angular/common": "21.2.11",
    "@angular/compiler": "21.2.11",
    "@angular/core": "21.2.11",
    "@angular/forms": "21.2.11",
    "@angular/platform-browser": "21.2.11",
    "@angular/platform-browser-dynamic": "21.2.11",
    "@angular/router": "21.2.11",
    "@primeng/themes": "^21.0.4",
    "body-parser": "^2.2.2",
    "cors": "^2.8.6",
    "d3": "^7.9.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "flatbuffers": "^25.9.23",
    "lodash": "^4.18.1",
    "primeicons": "^7.0.0",
    "primeng": "^21.1.6",
    "rxjs": "^7.8.2",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "source-map-support": "^0.5.21",
    "uuid": "^14.0.0",
    "wavefile": "^11.0.0",
    "zone.js": "^0.15.1"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "21.2.9",
    "@angular-eslint/eslint-plugin": "^21.3.1",
    "@angular/cli": "21.2.9",
    "@angular/compiler-cli": "21.2.11",
    "@angular/language-service": "21.2.11",
    "@types/body-parser": "^1.19.6",
    "@types/cors": "^2.8.19",
    "@types/d3": "^7.4.3",
    "@types/express": "^5.0.6",
    "@types/lodash": "^4.17.24",
    "@types/node": "^22.19.17",
    "@types/uuid": "^11.0.0",
    "@eslint/js": "^9.0.0",
    "@typescript-eslint/utils": "^8.59.1",
    "concurrently": "^9.2.1",
    "eslint": "^9.0.0",
    "globals": "^15.0.0",
    "typescript-eslint": "^8.0.0",
    "nodemon": "^3.1.14",
    "tsx": "^4.21.0",
    "typescript": "5.9.3"
  }
}
