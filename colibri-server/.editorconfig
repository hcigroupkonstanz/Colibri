# Editor configuration, see https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
max_line_length = off
trim_trailing_whitespace = false

[*.ts]
quote_type = single

[*.html]
indent_size = 2

[*.{yml,yaml}]
indent_size = 2

# Written by npm and the Angular CLI.
[{package.json,package-lock.json,angular.json}]
indent_size = 2
