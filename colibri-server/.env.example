# The *_HOST settings: '::' listens on IPv6 and IPv4, 0.0.0.0 on IPv4 only (https://colibri.hci.uni-konstanz.de/server/configuration).
# Default ports: 9212 (TCP), 9213 (voice) and 9211 (web). 1.x used 9012, 9013 and 9011.
TCP_HOST='::'
TCP_PORT=9212

VOICE_HOST='::'
VOICE_PORT=9213
VOICE_SAMPLING_RATE=48000
VOICE_RECORDING=false

WEBSERVER_HOST='::'
WEBSERVER_PORT=9211
WEBSERVER_ROOT='../ui/'
BASE_URL=''

DATA_ROOT='../../data'

# Days after which a data store value that has not been written again is deleted. 0: never.
STORE_EXPIRY_DAYS=0
# MiB that all data store values may take together; a PUT above it answers 507. 0: no limit.
STORE_MAX_MB=0

# Frames walked when capturing a stack trace for a logged error.
STACK_TRACE_LIMIT=30

# Least severe level printed to stdout/stderr (error, warn, info or debug). The admin UI's log
# keeps every level regardless. Broadcast traffic stays off the console unless switched on here.
CONSOLE_LOG_LEVEL=info
CONSOLE_LOG_BROADCAST_TRAFFIC=false

# How many messages from Unity (TCP) clients may be waiting for the server's main thread before it
# holds back incoming model::update messages - merged per object, so the latest value of every
# field still arrives, later - and drops broadcast::* messages. Nothing else is ever held back or
# dropped. Keeps an overloaded server's memory and latency bounded instead of queuing without
# limit. An overload that goes on for a second is logged as a warning; a shorter one - a brief
# stall at normal load - only at debug level. 0: no limit.
TCP_INBOUND_BACKLOG_LIMIT=2000

# Seconds a Unity (TCP) client may send nothing at all - not even its heartbeat replies, which it
# sends ten times a second - before it is disconnected as gone, e.g. a headset that left the Wi-Fi
# without closing its connection. Until then it counts as connected and keeps its app's synced
# objects alive. A client that has not handshaked within this time is dropped too. 0: never.
TCP_IDLE_TIMEOUT_SECONDS=10

# How many model::update and broadcast::* messages a second a single client (Unity or web) may
# send, and how many it may send at once after a quieter stretch. Beyond that its updates are held
# back and merged per object, and its broadcasts dropped, as above. Far above legitimate traffic
# (10 objects at 72 Hz is 720 a second): it catches a runaway send loop before it slows the server
# down for everyone. Logged as a warning naming the client once it has gone on for a second; a
# shorter burst only at debug level. 0: no limit.
CLIENT_MESSAGE_RATE_LIMIT=1000
CLIENT_MESSAGE_RATE_BURST=2000

# Log a warning when one app has more clients than this (Unity and web together, admin UI not
# counted). The server's work grows with the square of an app's size, so separate projects that
# all kept the same app name can overload it; the warning names the app. 0: never warn.
APP_CLIENT_WARNING_THRESHOLD=8

# Seconds the server remembers that a synced object (model) was deleted. Meanwhile a model::update
# for it from any other client - one sent before the delete reached that client, or queued while it
# was offline - is ignored instead of creating the object again for everyone. The client that
# deleted it can still create it again. Forgotten, like the models themselves, once an app's last
# client has left. 0: not remembered at all.
MODEL_TOMBSTONE_SECONDS=600

# TLS for the TCP port (Unity) and the web port: the PEM file of the certificate, followed by its
# chain if it has one (Let's Encrypt: fullchain.pem), and the PEM file of its private key (Let's
# Encrypt: privkey.pem). Set both, and the TCP port accepts only TLS connections - a Unity app then
# needs 'Server supports SSL/TLS?' ticked in its Colibri configuration - and the web port serves
# only HTTPS and WSS. Set neither, and both stay unencrypted. Either one alone, or a file the server
# cannot read or use, stops it at startup with a message saying what is wrong. A relative path is
# resolved like DATA_ROOT's. The certificate's SHA-256 fingerprint is logged at startup, and a renewed
# certificate in the same files is taken up within about 20 seconds, without a restart.
#TLS_CERT='/etc/colibri/tls/fullchain.pem'
#TLS_KEY='/etc/colibri/tls/privkey.pem'

# Reverse proxies trusted to report the client's address: IP addresses, CIDR ranges and the named
# ranges loopback, linklocal and uniquelocal, separated by commas, as in Express's 'trust proxy'.
# From these, a web client's address is read from X-Forwarded-For, and whether it used HTTPS from
# X-Forwarded-Proto, which the admin UI shows as TLS terminated by proxy. The proxy must set that
# header, replacing the client's (nginx: proxy_set_header X-Forwarded-Proto $scheme;): passed on
# unchanged, it lets a client claim HTTPS. Empty: none, and every client is logged at the address it
# connects from. With Docker behind a proxy on the host, 'loopback,uniquelocal': the proxy then
# comes from the Docker network's gateway. Voice from these addresses is relayed unchecked, so
# 'uniquelocal' turns the voice check off for every client on a private network. To keep it, trust
# only the gateway of a fixed compose subnet (https://colibri.hci.uni-konstanz.de/server/configuration#running-behind-a-reverse-proxy).
TRUSTED_PROXIES=''

# true: a connection to the TCP port from an address in TRUSTED_PROXIES has to start with a PROXY
# protocol header, which names the Unity client (nginx: proxy_protocol on; in the stream server).
# Set it here first, then in the proxy. Needs TRUSTED_PROXIES. Voice (UDP) still shows the proxy's
# address.
TCP_PROXY_PROTOCOL=false

# true: the proxy in front of the TCP port terminates TLS (nginx: listen 9212 ssl; in the stream
# server). Its PROXY protocol header does not say so. Without TLS_CERT, the admin UI then shows TLS
# terminated by proxy for a Unity client whose connection starts with a header from an address in
# TRUSTED_PROXIES. Only the display depends on it. Needs TCP_PROXY_PROTOCOL=true; without it, the
# server warns at startup that it has no effect.
TCP_TLS_AT_PROXY=false

# Where the proxy serves TLS, host[:port] separated by commas, port 443 unless given, e.g.
# colibri.example.org, colibri.example.org:9212. The server checks each certificate at startup and
# once an hour, as a client would, and the admin UI shows it. Empty: not checked.
PROXY_TLS_ADDRESSES=
