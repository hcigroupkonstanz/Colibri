{
    "name": "@hcikn/colibri",
    "version": "2.0.0",
    "description": "Communication Library for Research Prototyping - Allows object synchronization, networking, and voice chat with little to no code required",
    "type": "module",
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "import": {
                "types": "./dist/index.d.ts",
                "default": "./dist/index.js"
            },
            "require": {
                "types": "./dist/index.d.cts",
                "default": "./dist/index.cjs"
            }
        }
    },
    "engines": {
        "node": ">=18"
    },
    "scripts": {
        "build": "tsup",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "prepare": "cd .. && husky colibri-web/.husky",
        "prepublishOnly": "npm run build",
        "publish": "npm run build && npm publish --access public",
        "samples/broadcast": "tsx samples/broadcast.ts",
        "samples/model-sync": "tsx samples/model-sync.ts",
        "samples/remote-logging": "tsx samples/remote-logging.ts",
        "samples/rest-api": "tsx samples/rest-api.ts",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:coverage": "vitest run --coverage",
        "test:e2e": "vitest run --config vitest.e2e.config.ts",
        "test:e2e:watch": "vitest --config vitest.e2e.config.ts"
    },
    "author": "HCI Group, University of Konstanz",
    "license": "MIT",
    "homepage": "https://github.com/hcigroupkonstanz/colibri",
    "repository": {
        "type": "git",
        "url": "https://github.com/hcigroupkonstanz/colibri.git"
    },
    "files": [
        "/dist"
    ],
    "publishConfig": {
        "access": "public"
    },
    "peerDependencies": {
        "rxjs": "^7.8.1"
    },
    "dependencies": {
        "socket.io-client": "^4.7.1",
        "ts-custom-error": "^3.3.1"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@stylistic/eslint-plugin": "^5.10.0",
        "@swc/core": "^1.3.96",
        "@types/lodash": "^4.14.195",
        "@types/node": "^20.19.39",
        "@vitest/coverage-v8": "^3.2.4",
        "eslint": "^10.7.0",
        "eslint-plugin-n": "^18.2.2",
        "eslint-plugin-promise": "^7.3.0",
        "husky": "^9.1.7",
        "lint-staged": "^15.5.2",
        "rxjs": "^7.8.1",
        "tsup": "^7.2.0",
        "tsx": "^4.21.0",
        "typescript": "^5.1.6",
        "typescript-eslint": "^8.65.0",
        "vitest": "^3.2.4"
    },
    "lint-staged": {
        "**/*.{ts,js}": "npm run lint:fix"
    }
}
